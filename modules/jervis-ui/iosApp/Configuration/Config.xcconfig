JERVIS_GOOGLE_WEB_CLIENT_ID=
JERVIS_GOOGLE_IOS_CLIENT_ID=
JERVIS_GOOGLE_IOS_REVERSED_CLIENT_ID=
#include? "Auth.xcconfig"
