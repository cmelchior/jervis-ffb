# Secrets referenced by env() in config.toml.
#
# Copy this file to `.env.local` (which is ignored by Git) and fill in the real
# values. The Supabase CLI reads `.env` and then `.env.local` from this
# directory, so `.env.local` wins. Never put real keys in this file.
#
# See docs/working-with-supabase.md

# Resend API key, used as the SMTP password by Supabase Auth.
# Created under https://resend.com/api-keys with "Sending access" only.
RESEND_SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
